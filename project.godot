; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Londpunk"
run/main_scene="res://levels/TestLevel.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/event_bus.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

move_click={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":1,"pressed":true,"script":null)
]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0,"script":null)
]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0,"script":null)
]
}
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0,"script":null)
]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0,"script":null)
]
}
cam_pan_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65,"script":null)
, Object(InputEventKey,"device":-1,"physical_keycode":4194319,"script":null)
]
}
cam_pan_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68,"script":null)
, Object(InputEventKey,"device":-1,"physical_keycode":4194321,"script":null)
]
}
cam_pan_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87,"script":null)
, Object(InputEventKey,"device":-1,"physical_keycode":4194320,"script":null)
]
}
cam_pan_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83,"script":null)
, Object(InputEventKey,"device":-1,"physical_keycode":4194322,"script":null)
]
}
cam_rotate_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":81,"script":null)
, Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":-1.0,"script":null)
]
}
cam_rotate_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":69,"script":null)
, Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":1.0,"script":null)
]
}
cam_tilt_up={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":-1.0,"script":null)
]
}
cam_tilt_down={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":1.0,"script":null)
]
}
cam_zoom_in={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":4,"pressed":true,"script":null)
]
}
cam_zoom_out={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":5,"pressed":true,"script":null)
]
}
cam_zoom_in_stick={
"deadzone": 0.1,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":5,"axis_value":1.0,"script":null)
]
}
cam_zoom_out_stick={
"deadzone": 0.1,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":4,"axis_value":1.0,"script":null)
]
}
cam_rotate_drag={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":3,"pressed":true,"script":null)
]
}
cam_focus_player={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":70,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":3,"pressed":true,"script":null)
]
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
